# Sao chep cac dong can thiet vao backend/.env va dien gia tri tu Cloudinary Console.
# KHONG commit backend/.env len GitHub.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP (tao App Password trong Google Account; khong dung mat khau Gmail thong thuong)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=DaNangRealEstate <yourgmail@gmail.com>
